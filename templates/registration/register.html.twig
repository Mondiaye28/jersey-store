{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.register.title'|trans }}{% endblock %}

{% block body %}
    {# Bloc centré : titre, formulaire et lien secondaire #}
    <div class="page-formulaire">
        <h1>{{ 'auth.register.title'|trans }}</h1>

        {{ form_start(registrationForm) }}
            {{ form_row(registrationForm.nom) }}
            {{ form_row(registrationForm.prenom) }}
            {{ form_row(registrationForm.email) }}
            {{ form_row(registrationForm.plainPassword) }}
            <button type="submit" class="bouton bouton-principal">{{ 'auth.register.submit'|trans }}</button>
        {{ form_end(registrationForm) }}

        <p class="lien-secondaire"><a href="{{ path('app_login') }}">{{ 'auth.register.has_account'|trans }}</a></p>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }}{% endblock %}

{% block body %}
    <p class="fil-retour"><a href="{{ path('app_home') }}">{{ 'produit.retour'|trans }}</a></p>

    {# Fiche en deux colonnes : la photo, puis les informations et l'achat #}
    <article class="fiche">
        <div class="fiche-visuel">
            {% if produit.photo %}
                <img src="{{ asset('uploads/produits/' ~ produit.photo) }}" alt="{{ produit.nom }}">
            {% else %}
                <span class="maillot-sans-photo" aria-hidden="true">{{ produit.nom|first|upper }}</span>
                <p class="fiche-sans-photo">{{ 'produit.sans_photo'|trans }}</p>
            {% endif %}
        </div>

        <div class="fiche-infos">
            <h1 class="titre-floque">{{ produit.nom }}</h1>

            {# Chaque chiffre est groupé avec son libellé (div autorisé dans un dl) #}
            <dl class="fiche-chiffres">
                <div>
                    <dt>{{ 'produit.champ.prix'|trans }}</dt>
                    <dd class="fiche-prix">{{ produit.prix|format_currency('EUR') }}</dd>
                </div>
                <div>
                    <dt>{{ 'produit.champ.stock'|trans }}</dt>
                    <dd class="fiche-stock">{{ produit.stock }}</dd>
                </div>
            </dl>

            {# nl2br conserve les retours à la ligne de la description (le texte reste échappé) #}
            <p class="fiche-description">{{ produit.description|nl2br }}</p>

            {# Ajout au panier réservé aux utilisateurs connectés, par POST avec jeton CSRF #}
            {% if is_granted('ROLE_USER') %}
                <form method="post" action="{{ path('app_panier_ajouter', {id: produit.id}) }}" class="fiche-achat">
                    <div class="champ champ-quantite">
                        <label for="quantite">{{ 'panier.colonne.quantite'|trans }}</label>
                        <input type="number" id="quantite" name="quantite" value="1" min="1" required>
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('ajouter_panier_' ~ produit.id) }}">
                    <button type="submit" class="bouton bouton-principal ajouter-panier">{{ 'produit.action.ajouter_panier'|trans }}</button>
                </form>
            {% endif %}

            {# Gestion du produit réservée aux administrateurs #}
            {% if is_granted('ROLE_ADMIN') %}
                <div class="fiche-admin">
                    <a href="{{ path('app_produit_edit', {id: produit.id}) }}" class="bouton bouton-secondaire">{{ 'produit.action.modifier'|trans }}</a>

                    {# Suppression par POST avec jeton CSRF, jamais par un simple lien #}
                    <form method="post" action="{{ path('app_produit_delete', {id: produit.id}) }}"
                          onsubmit="return confirm('{{ 'produit.confirmer_suppression'|trans|e('js') }}');">
                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer_produit_' ~ produit.id) }}">
                        <button type="submit" class="bouton bouton-danger">{{ 'produit.action.supprimer'|trans }}</button>
                    </form>
                </div>
            {% endif %}
        </div>
    </article>
{% endblock %}

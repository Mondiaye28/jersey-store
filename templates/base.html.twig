<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'site.title'|trans }}{% endblock %}</title>
        {# Favicon : un « J » or sur fond noir, aux couleurs de la boutique #}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2224%22 fill=%22%23000%22/><text x=%2264%22 y=%2298%22 text-anchor=%22middle%22 font-family=%22Impact,Arial Narrow,sans-serif%22 font-size=%2296%22 font-weight=%22900%22 fill=%22%23e9b949%22>J</text></svg>">
        {# Polices : Big Shoulders Display (titres et prix, façon flocage de maillot) et Archivo (texte) #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Big+Shoulders+Display:wght@700;800;900&display=swap">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {#
            Barre de navigation : chaque lien est conditionné par is_granted(),
            pour ne jamais pointer vers une page interdite au rôle courant.
            ROLE_SUPER_ADMIN hérite de ROLE_ADMIN, qui hérite de ROLE_USER.
        #}
        <header class="site-header">
            <a href="{{ path('app_home') }}" class="marque">{{ 'site.marque'|trans }}</a>
            {# Route courante : le lien de la page affichée est marqué aria-current="page" (souligné en or) #}
            {% set route = app.request.attributes.get('_route') %}
            <nav aria-label="{{ 'nav.libelle'|trans }}">
                <a href="{{ path('app_home') }}" {% if route == 'app_home' %}aria-current="page"{% endif %}>{{ 'nav.accueil'|trans }}</a>
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('app_panier') }}" class="nav-panier" {% if route == 'app_panier' %}aria-current="page"{% endif %}>{{ 'nav.panier'|trans }}</a>
                    <a href="{{ path('app_compte') }}" class="nav-compte" {% if route in ['app_compte', 'app_commande_show'] %}aria-current="page"{% endif %}>{{ 'nav.compte'|trans }}</a>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_produit_new') }}" class="nav-ajouter-produit" {% if route == 'app_produit_new' %}aria-current="page"{% endif %}>{{ 'nav.ajouter_produit'|trans }}</a>
                {% endif %}
                {% if is_granted('ROLE_SUPER_ADMIN') %}
                    <a href="{{ path('app_super_admin') }}" class="nav-super-admin" {% if route == 'app_super_admin' %}aria-current="page"{% endif %}>{{ 'nav.super_admin'|trans }}</a>
                {% endif %}
                {% if is_granted('IS_AUTHENTICATED') %}
                    <span class="nav-utilisateur">{{ app.user.prenom }} {{ app.user.nom }}</span>
                    <a href="{{ path('app_logout') }}" class="nav-deconnexion">{{ 'nav.deconnexion'|trans }}</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="nav-connexion" {% if route == 'app_login' %}aria-current="page"{% endif %}>{{ 'nav.connexion'|trans }}</a>
                    <a href="{{ path('app_register') }}" class="nav-inscription" {% if route == 'app_register' %}aria-current="page"{% endif %}>{{ 'nav.inscription'|trans }}</a>
                {% endif %}

                {# Sélecteur de langue : la langue choisie est gardée en session #}
                <span class="langues">
                    {% for code in ['fr', 'en'] %}
                        <a href="{{ path('app_langue', {locale: code}) }}" class="langue-{{ code }}" lang="{{ code }}"
                           title="{{ ('langue.' ~ code)|trans }}"
                           {% if app.request.locale == code %}aria-current="true"{% endif %}>{{ code|upper }}</a>
                    {% endfor %}
                </span>
            </nav>
        </header>

        <main class="page">
            {# Messages flash : succès (success) ou échec (error) des actions #}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}" role="alert">{{ message|trans }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
